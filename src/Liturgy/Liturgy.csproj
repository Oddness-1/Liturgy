<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Liturgy</AssemblyName>
    <RootNamespace>Liturgy</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet packaging. Pack with: dotnet pack -c ExportRelease (Debug builds reference GodotSharpEditor). -->
    <IsPackable>true</IsPackable>
    <PackageId>Liturgy.Godot</PackageId>
    <Version>0.1.0</Version>
    <Authors>Oddness</Authors>
    <Description>Attribute-based global hooks for Godot C#. Mark static methods with [Rite.OnReady], [Rite.OnButtonPressed], [Rite.OnProcess] and more, and Liturgy wires them up across the whole scene tree. No addon, no autoload, no setup.</Description>
    <PackageTags>godot;godot4;gamedev;attributes;hooks;signals;source-generator</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Oddness-1/Liturgy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Oddness-1/Liturgy.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2025-2026 Oddness</Copyright>
    <PackageReleaseNotes>First public release.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The maintainer's local feed; anyone else's pack lands in the usual bin folder. -->
    <PackageOutputPath Condition="Exists('S:\Game Dev\Libraries\NuGet (Local)')">S:\Game Dev\Libraries\NuGet (Local)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the generator first; it ships inside this package rather than as a dependency. -->
    <ProjectReference Include="..\Liturgy.Generators\Liturgy.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harness shows the sections a project hasn't seen yet when Liturgy updates. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Liturgy.CHANGELOG.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\Liturgy.Generators\bin\$(Configuration)\netstandard2.0\Liturgy.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
