<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- A second assembly that uses Liturgy, loaded only when the sandbox first touches it. Checks that Liturgy finds its rites anyway. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Liturgy\Liturgy.csproj" />
    <ProjectReference Include="..\..\src\Liturgy.Generators\Liturgy.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
